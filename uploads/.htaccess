# Uploaded files are data, not executable documents.
Options -Indexes
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|html?|xhtml|shtml|svg|xml|js|mjs)$">
    Require all denied
</FilesMatch>
